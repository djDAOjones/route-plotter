{
  "entry": [
    "src/exported/*.ts",
    "eslint.base.mjs",
    "eslint.a11y.mjs",
    "tests/bundle/*.test.mjs",
    "tests/architecture/*.test.mjs",
    "tests/a11y/**/*.{ts,mjs}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "tests/**/*.{ts,mjs}"
  ],
  "ignore": [
    "v3/**",
    "tests/bundle/fixtures/**",
    "tests/architecture/fixtures/**"
  ],
  "vitest": {
    "config": [
      "vite.config.mjs"
    ],
    "entry": [
      "src/core/**/*.test.ts"
    ]
  },
  "node": false,
  "playwright": false,
  "ignoreDependencies": [
    "@ibm/plex",
    "@types/prop-types",
    "axe-core",
    "jszip",
    "mediabunny"
  ]
}
