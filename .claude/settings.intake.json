{
  "permissions": {
    "deny": [
      "RemoteTrigger",
      "EnterWorktree",
      "ExitWorktree",
      "CronCreate",
      "CronDelete",
      "CronList",
      "ScheduleWakeup",
      "SendMessage",
      "Workflow",
      "ReportFindings",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git clone *)",
      "Bash(npx -y *)",
      "Bash(npx --yes *)",
      "Bash(pip install *)",
      "Bash(brew *)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Write(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Write(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)",
      "Write(~/.config/gcloud/**)",
      "Read(~/.claude/**)",
      "Edit(~/.claude/**)",
      "Write(~/.claude/**)",
      "Read(~/.codex/**)",
      "Edit(~/.codex/**)",
      "Write(~/.codex/**)",
      "Read(~/.npmrc/**)",
      "Edit(~/.npmrc/**)",
      "Write(~/.npmrc/**)"
    ]
  },
  "autoMemoryEnabled": false,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "gh *"
    ],
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gcloud",
        "~/.claude",
        "~/.codex",
        "~/.npmrc"
      ],
      "denyWrite": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gcloud",
        "~/.claude",
        "~/.codex",
        "~/.npmrc"
      ]
    },
    "network": {
      "allowedDomains": [
        "*"
      ],
      "strictAllowlist": false
    },
    "credentials": {
      "envVars": [
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "CLAUDE_CODE_OAUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "OPENAI_API_KEY",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        }
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/tools/session.mjs\" --harness claude",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/tools/session.mjs\" --harness claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/tools/session.mjs\" --harness claude",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "_pm_next_v3": "INTAKE ONLY: the network is open so official sources can be read for digests, whatever the Network line says for sessions. Run `claude --settings .claude/settings.intake.json`, with the owner present. Ordinary sessions use settings.json. Session hooks (3.15): SessionStart(compact) adds the re-read and session-end notice; tools/session.mjs on PostToolUse and the other SessionStart sources watches this session's context against the profile's Session line (200k tokens of context). They force nothing and cannot show that a re-read happened; where the client does not run them, or denies them the transcript, the Session line is an instruction only. Claude Code merges hooks from every settings file it loads, so with the project settings present each hook runs twice in intake; the sensor's state makes the second threshold notice silent, and the compaction notice repeats."
}
