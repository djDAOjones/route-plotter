{
  "name": "route-plotter",
  "private": true,
  "description": "Route Plotter v4: an animated route editor for maps and images. Frozen v3 lives in v3/ with its own package.",
  "license": "MIT",
  "scripts": {
    "check": "node scripts/gate.mjs",
    "check:v4": "npm run typecheck && npm run lint && npm run boundaries && npm run deadcode && npm test && npm run build && npm run test:bundle && npm run a11y && npm run a11y:known-bad",
    "typecheck": "tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src",
    "boundaries": "depcruise --config .dependency-cruiser.cjs src",
    "deadcode": "knip",
    "test": "vitest run --maxWorkers=3",
    "build": "vite build && vite build --mode player",
    "test:bundle": "node --test \"tests/bundle/*.test.mjs\"",
    "a11y": "node tools/a11y-run.mjs",
    "a11y:known-bad": "node tests/a11y/non-vacuity.mjs",
    "dev": "vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "@carbon/react": "1.118.0",
    "jszip": "3.10.1",
    "mediabunny": "1.55.3",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@ibm/plex": "6.4.1",
    "@playwright/test": "1.56.1",
    "@types/prop-types": "15.7.15",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "axe-core": "4.13.0",
    "dependency-cruiser": "18.6.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "knip": "6.41.0",
    "sass": "1.105.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.2.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.56.1"
    }
  }
}
